<?xml version="1.0"?>
<ruleset>
	<rule ref="./vendor/mediawiki/mediawiki-codesniffer/MediaWiki">
		<!--
			The ported classes document why rather than what, and several carry
			long explanations of Lua behaviour being reproduced deliberately.
			Those comments are the point, so the line-length rule is relaxed
			rather than the comments trimmed.
		-->
		<exclude name="Generic.Files.LineLength"/>

		<!--
			Not enforced, deliberately. The MediaWiki standard wants an @param
			for every parameter; these docblocks document the parameters whose
			meaning is not obvious from the signature and leave the rest.

			This was tried the other way first: generating the missing 140 tags
			mechanically produced lines like "@param string $key" that say
			nothing, collapsed several multi-line explanations into single
			250-character lines, and corrupted one file outright. The comments
			are the part of this port that carries the reasoning, so they win
			over tag completeness. Revisit if the extension is submitted to
			Wikimedia review, where the standard is not negotiable.
		-->
		<exclude name="MediaWiki.Commenting.FunctionComment.MissingParamTag"/>
		<exclude name="MediaWiki.Commenting.FunctionComment.ParamNameNoMatch"/>
	</rule>

	<file>.</file>

	<!-- Third-party code and generated output. -->
	<exclude-pattern>vendor/</exclude-pattern>
	<exclude-pattern>node_modules/</exclude-pattern>
	<exclude-pattern>modules/</exclude-pattern>
	<!-- Recorded parity output: large JSON captures, not source. -->
	<exclude-pattern>tests/parity/output/</exclude-pattern>
	<!-- Snapshots of the on-wiki Lua, kept byte-identical to the source of record. -->
	<exclude-pattern>docs/legacy-lua/</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="encoding" value="UTF-8"/>
</ruleset>
